# Copy this to .env.local and fill in your API key.
# .env.local is gitignored — never commit your key.

# xAI Grok (current default — see MODEL in src/engine/adjudicate.ts)
XAI_API_KEY=...

# Google Gemini (swap MODEL in src/engine/adjudicate.ts)
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Anthropic Claude (swap MODEL in src/engine/adjudicate.ts)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (swap MODEL in src/engine/adjudicate.ts)
# OPENAI_API_KEY=sk-...

# OpenRouter — access to many additional (incl. free-tier) models via one key.
# Use with createOpenAI({ baseURL: 'https://openrouter.ai/api/v1', apiKey: process.env.OPENROUTER_API_KEY }).chat(modelId)
# OPENROUTER_API_KEY=...
