# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit real keys or tokens.
# Local play needs only ANTHROPIC_API_KEY. The rest is for the Vercel
# deployment (set those in the Vercel dashboard, not here).

# Required everywhere. Server-side only; never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-paste_your_key_here

# Required on Vercel (app refuses to boot without it): 32+ random characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required on Vercel: one Redis pair from Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ...or the names the Vercel Marketplace Upstash integration creates:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: shared daily spend cap in USD across all players (default 2).
# MAX_DAILY_SPEND_USD=2

# Optional: off / 0 / false stops web transcript recording.
# If off, also remove #transcript-notice in public/index.html.
# TRANSCRIPTS=off

# DEV ONLY, local server: lets POST /api/game pin the seed/template.
# Ignored on Vercel production. Never set in a deployed environment.
# ALLOW_CLIENT_SEED=1