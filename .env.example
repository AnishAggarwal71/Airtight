# Copy this file to .env.local and paste your GroqCloud key after the equals sign.
# The game automatically uses Groq whenever GROQ_API_KEY is set.
# .env.local is gitignored — never commit your key.
GROQ_API_KEY=gsk_paste_your_groq_key_here

# Optional: Groq model (defaults to openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback if GROQ_API_KEY is absent: xAI
# XAI_API_KEY=...
